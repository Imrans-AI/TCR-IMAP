-        logger.info('Epoch:[{}/{}]\t trainloss={:.9f}\t testauc={:.9f}\t testaupr={:.9f}'.format(i + 1, epoch, trainloss / len(ids), auc, aupr))
+        logger.info('Epoch:[{}/{}]\t trainloss={:.9f}\t valauc={:.9f}\t valaupr={:.9f}'.format(i + 1, epoch, trainloss / len(traintuple), auc, aupr))
         if earlystop == 10:
