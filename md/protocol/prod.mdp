; Stage 3 - production, 200 ns, 4 fs with HMR topology, unrestrained, NPT 300 K / 1 bar.
; Protein-only (SOLU) compressed trajectory every 20 ps -> 10,001 frames per replicate.
integrator              = md
dt                      = 0.004
nsteps                  = 50000000
nstxout-compressed      = 5000
compressed-x-grps       = SOLU
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstcalcenergy           = 100
nstenergy               = 5000
nstlog                  = 5000
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
coulombtype             = PME
rcoulomb                = 1.2
tcoupl                  = v-rescale
tc_grps                 = SOLU SOLV
tau_t                   = 1.0 1.0
ref_t                   = 300 300
constraints             = h-bonds
constraint_algorithm    = LINCS
nstcomm                 = 100
comm_mode               = linear
comm_grps               = SOLU SOLV
pcoupl                  = C-rescale
pcoupltype              = isotropic
tau_p                   = 5.0
compressibility         = 4.5e-5
ref_p                   = 1.0
continuation            = yes
